{
  "multipart": [
    {
      "when": {
        "formed": "false",
        "active": "false"
      },
      "apply": {
        "model": "stargate:block/stargate_control"
      }
    },
    {
      "when": {
        "formed": "false",
        "active": "true"
      },
      "apply": {
        "model": "stargate:block/stargate_control_active"
      }
    },
